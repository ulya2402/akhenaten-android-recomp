<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#120E09"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingVertical="14dp"
    tools:context=".DirectorySelectionActivity">

    <!-- Top Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginEnd="12dp"
            android:contentDescription="App Icon"
            android:src="@mipmap/akhenaten" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.14"
                android:text="AKHENATEN"
                android:textColor="#D4AF37"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/header_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pharaoh + Cleopatra • Native ARM64"
                android:textColor="#B8A37E"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_language"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="10dp"
            android:backgroundTint="#261D12"
            android:text="ID / EN"
            android:textColor="#D4AF37"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#261D12"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="NEEDS DATA"
            android:textColor="#D4AF37"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Tab Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="#1A140C"
        android:orientation="horizontal"
        android:padding="4dp">

        <Button
            android:id="@+id/tab_play"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:backgroundTint="#D4AF37"
            android:text="Main &amp; Data"
            android:textColor="#120E09"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/tab_graphics"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:backgroundTint="#261D12"
            android:text="Grafis &amp; Layar"
            android:textColor="#E8D5B5"
            android:textSize="12sp" />

        <Button
            android:id="@+id/tab_controls"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:backgroundTint="#261D12"
            android:text="Kontrol &amp; Hotkey"
            android:textColor="#E8D5B5"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Tab Content Container -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- TAB 1: PLAY & DATA -->
            <LinearLayout
                android:id="@+id/panel_play"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#1E1710"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/play_card_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Data Game Pharaoh (Android SAF)"
                    android:textColor="#F3E5AB"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/folder_status_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="#C9B99A"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/directory_selector_button"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="10dp"
                        android:layout_weight="1"
                        android:backgroundTint="#332719"
                        android:text="Pilih Folder"
                        android:textColor="#E8D5B5"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/play_game_button"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1.2"
                        android:backgroundTint="#D4AF37"
                        android:text="MAIN SEKARANG"
                        android:textColor="#120E09"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- TAB 2: GRAPHICS & DISPLAY -->
            <LinearLayout
                android:id="@+id/panel_graphics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#1E1710"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/gfx_card_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pengaturan Grafis &amp; Layar Penuh"
                    android:textColor="#F3E5AB"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_immersive"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Fullscreen Immersive (Sembunyikan Notch &amp; Bar)"
                    android:textColor="#E8D5B5"
                    android:textSize="13sp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_show_fps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Tampilkan Info Performa (FPS)"
                    android:textColor="#E8D5B5"
                    android:textSize="13sp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_show_log"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Tampilkan Log Debug (Untuk Troubleshooting)"
                    android:textColor="#E8D5B5"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_screen_fit"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:backgroundTint="#2B2114"
                        android:text="Layar: Fullscreen Fit"
                        android:textColor="#D4AF37"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btn_ui_scale"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:backgroundTint="#2B2114"
                        android:text="Skala UI: Auto"
                        android:textColor="#D4AF37"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- TAB 3: CONTROLS & HOTKEYS -->
            <LinearLayout
                android:id="@+id/panel_controls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#1E1710"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/ctrl_card_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kontrol Sentuh, Hotkeys &amp; Panduan"
                    android:textColor="#F3E5AB"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_side_bar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Bar Quick-Action &amp; Hotkey di Samping Layar"
                    android:textColor="#E8D5B5"
                    android:textSize="13sp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_auto_launch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Langsung Masuk Game Saat Aplikasi Dibuka"
                    android:textColor="#E8D5B5"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_touch_mode"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="#2B2114"
                    android:text="Mode Sentuh: City-Builder"
                    android:textColor="#D4AF37"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/controls_guide_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="#15100A"
                    android:padding="10dp"
                    android:textColor="#C9B99A"
                    android:textSize="12sp" />
            </LinearLayout>
        </FrameLayout>
    </ScrollView>
</LinearLayout>
